# Copy to .env.prod ON THE SERVER and fill in. Never commit .env.prod.

# Public API hostname (must point to the VM's IP), no https:// and no slash
DOMAIN=myfintech.duckdns.org

# Exact URL of the frontend on Vercel (no trailing slash). Used for CORS and reset-password links.
CORS_ALLOWED_ORIGIN=https://your-app.vercel.app

# Generate with:  openssl rand -base64 48
JWT_SECRET=
MYSQL_ROOT_PASSWORD=
POSTGRES_PASSWORD=

# New key from https://openrouter.ai/keys (do not reuse the one from development)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-haiku-4.5
